{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sandbox: check syntax and public-data safety",
      "type": "shell",
      "command": "npm run check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Sandbox: run unit tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Sandbox: full local audit checks",
      "dependsOn": [
        "Sandbox: check syntax and public-data safety",
        "Sandbox: run unit tests"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
